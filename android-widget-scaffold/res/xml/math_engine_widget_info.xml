<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget V1 sizing/behavior metadata. minWidth/minHeight sized for a
  standard 2x1 launcher grid cell (widely compatible default) —
  intentionally NOT resizable in V1 (resizeMode="none") since a fixed
  single tap-target layout has nothing meaningful to resize into yet;
  revisit when V2 adds richer content that could use extra space.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_math_engine"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description">
</appwidget-provider>
